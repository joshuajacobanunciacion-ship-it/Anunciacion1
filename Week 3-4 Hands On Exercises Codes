{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void btnFight_Click(object sender, EventArgs e)
        {
            string weapon = cmbWeapon.Text;

            switch(weapon)

            {
                case "Sword":
                    lblResult.Text = "You swing the sword!";
                    break;

                case "Bow":
                    lblResult.Text = "You shoot an arrow!";
                    break;

                case "Magic":
                    lblResult.Text = "You cast a spell!";
                    break;

                default:
                    lblResult.Text = "You have no weapon!";
                    break;
            }
        }
