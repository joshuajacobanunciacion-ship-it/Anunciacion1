        {
            int secret = 67;
            int guess = Convert.ToInt32(txtGuess.Text);

            while (guess != secret)
            {
                if (guess < secret)
                {
                    lblMessage.Text = "Too low! Try again.";
                }
                else
                {
                    lblMessage.Text = "Too high! Try again.";
                }
                return;
            }
            lblMessage.Text = "Congratulations! You guessed the secret number.";
        }

