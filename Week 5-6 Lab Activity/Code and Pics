        // App 13: recursive Fibonacci
        private void button13_Click(object sender, EventArgs e)
        {
            int n;
            if (!int.TryParse(textBox13.Text, out n) || n < 0 || n > 35)
            {
                label13.Text = "Enter a number from 0 to 35";
                return;
            }
            label13.Text = "Fibonacci(" + n + ") = " + Fibonacci(n);
        }

        private int Fibonacci(int n)
        {
            if (n <= 1) return n;
            return Fibonacci(n - 1) + Fibonacci(n - 2);
        }

        // App 14: list all binary strings of a given length
        private void button14_Click(object sender, EventArgs e)
        {
            int n;
            if (!int.TryParse(textBox14.Text, out n) || n < 1 || n > 4)
            {
                label14.Text = "Enter a number from 1 to 4";
                return;
            }

            List<string> results = new List<string>();
            ListBinary("", n, results);
            label14.Text = string.Join(", ", results) + "\nTotal = " + results.Count;
        }

        private void ListBinary(string current, int length, List<string> results)
        {
            if (current.Length == length)
            {
                results.Add(current);
                return;
            }
            ListBinary(current + "0", length, results);   // choice 1
            ListBinary(current + "1", length, results);   // choice 2
        }

        // App 15: Tower of Hanoi - number of moves
        private void button15_Click(object sender, EventArgs e)
        {
            int n;
            if (!int.TryParse(textBox15.Text, out n) || n < 1 || n > 25)
            {
                label15.Text = "Enter a number from 1 to 25";
                return;
            }
            label15.Text = n + " disks need " + Hanoi(n) + " moves";
        }

        private int Hanoi(int n)
        {
            if (n == 0) return 0;
            return Hanoi(n - 1) + 1 + Hanoi(n - 1);
        }
