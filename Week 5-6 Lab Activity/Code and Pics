        // App 4: binary search
        private void button4_Click(object sender, EventArgs e)
        {
            int[] sorted = { 2, 5, 8, 12, 16, 23, 38, 56, 72, 91 };
            int target;
            if (!int.TryParse(textBox4.Text, out target))
            {
                label4.Text = "Enter a whole number";
                return;
            }

            int steps;
            int index = BinarySearch(sorted, target, out steps);
                if (index == -1)
                label4.Text = target + " not found (" + steps + " steps)";
                else
                label4.Text = target + " found at index " + index + " (" + steps + " steps)";
        }

        private int BinarySearch(int[] arr, int target, out int steps)
        {
            int low = 0, high = arr.Length - 1;
            steps = 0;
            while (low <= high)
            {
                steps++;
                int mid = (low + high) / 2;
                if (arr[mid] == target) return mid;
                    if (arr[mid] < target) low = mid + 1;
                    else high = mid - 1;
            }
            return -1;
        }

        // App 5: how many times can a number be halved until 1?
        private void button5_Click(object sender, EventArgs e)
        {
            int n;
            if (!int.TryParse(textBox5.Text, out n) || n < 1)
            {
                label5.Text = "Enter a number 1 or higher";
                return;
            }

            int original = n;
            int steps = 0;
            while (n > 1)
            {
                n = n / 2;
                steps++;
            }
            label5.Text = original + " halved to 1 in " + steps + " steps";
        }

        // App 6: guess the secret number (1-100) by halving
        private void button6_Click(object sender, EventArgs e)
        {
            int secret;
            if (!int.TryParse(textBox6.Text, out secret) || secret < 1 || secret > 100)
            {
                label6.Text = "Enter a number from 1 to 100";
                return;
            }

            int low = 1, high = 100, guesses = 0;
            while (low <= high)
            {
                int mid = (low + high) / 2;
                guesses++;
                if (mid == secret) break;
                    if (mid < secret) low = mid + 1;
                    else high = mid - 1;
            }
            label6.Text = "Found " + secret + " in " + guesses + " guesses";
        }

