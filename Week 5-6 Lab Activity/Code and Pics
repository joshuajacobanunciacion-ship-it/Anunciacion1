        // App 10: multiplication table (n x n)
        private void button10_Click(object sender, EventArgs e)
        {
            int n;
            if (!int.TryParse(textBox10.Text, out n) || n < 1 || n > 9)
            {
                label10.Text = "Enter a number from 1 to 9";
                return;
            }

            string table = "";
            for (int i = 1; i <= n; i++)
            {
                for (int j = 1; j <= n; j++)
                {
                    table += (i * j).ToString().PadLeft(4);
                }
                table += "\n";
            }
            label10.Text = table + "\n" + (n * n) + " steps";
        }

        // App 11: bubble sort
        private void button11_Click(object sender, EventArgs e)
        {
            List<int> list = ReadNumbers(textBox11.Text);
            if (list == null)
            {
                label11.Text = "Enter numbers like: 5, 3, 8, 1";
                return;
            }

            int[] arr = list.ToArray();
            for (int i = 0; i < arr.Length - 1; i++)
            {
                for (int j = 0; j < arr.Length - 1 - i; j++)
                {
                    if (arr[j] > arr[j + 1])
                    {
                        int temp = arr[j];
                        arr[j] = arr[j + 1];
                        arr[j + 1] = temp;
                    }
                }
            }
            label11.Text = "Sorted: " + string.Join(", ", arr);
        }

        // App 12: check for duplicates
        private void button12_Click(object sender, EventArgs e)
        {
            List<int> list = ReadNumbers(textBox12.Text);
            if (list == null)
            {
                label12.Text = "Enter numbers like: 1, 2, 3, 2";
                return;
            }

            bool hasDuplicate = false;
            for (int i = 0; i < list.Count; i++)
            {
                for (int j = i + 1; j < list.Count; j++)
                {
                    if (list[i] == list[j]) hasDuplicate = true;
                }
            }
            label12.Text = hasDuplicate ? "Has duplicates" : "No duplicates";
        }

