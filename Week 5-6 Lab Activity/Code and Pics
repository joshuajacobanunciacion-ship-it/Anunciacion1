        // Will turn "5, 3, 8" into a list of numbers. Returns if the input is invalid.
        private List<int> ReadNumbers(string text)
        {
            List<int> list = new List<int>();
            foreach (string part in text.Split(','))
            {
                int n;
                if (!int.TryParse(part.Trim(), out n)) return null;
                list.Add(n);
            }
            return list;
        }

